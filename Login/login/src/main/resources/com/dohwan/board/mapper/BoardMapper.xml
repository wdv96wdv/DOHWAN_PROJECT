<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dohwan.board.mapper.BoardMapper">

    <!-- ResultMap -->
    <resultMap id="BoardMap" type="com.dohwan.board.domain.Boards">
        <id property="no" column="no"/>
        <result property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="writer" column="writer"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="userNo" column="user_no"/>
        <result property="commentCount" column="comment_count"/>
        
        <!-- 메인 파일 연관 매핑 (JOIN 방식) -->
        <association property="file" javaType="com.dohwan.board.domain.Files">
            <id property="no" column="file_no"/>
            <result property="id" column="file_id"/>
            <result property="pTable" column="file_p_table"/>
            <result property="pNo" column="file_p_no"/>
            <result property="fileName" column="file_file_name"/>
            <result property="originName" column="file_origin_name"/>
            <result property="filePath" column="file_file_path"/>
            <result property="fileSize" column="file_file_size"/>
            <result property="seq" column="file_seq"/>
            <result property="type" column="file_type"/>
            <result property="createdAt" column="file_created_at"/>
            <result property="updatedAt" column="file_updated_at"/>
        </association>
    </resultMap>

    <!-- 전체 목록 조회 (JOIN을 사용하여 N+1 쿼리 문제 해결) -->
    <select id="list" resultMap="BoardMap">
        SELECT 
            b.no,
            b.id,
            b.title,
            b.writer,
            b.content,
            b.created_at,
            b.updated_at,
            b.user_no,
            COUNT(c.no) as comment_count,
            f.no AS file_no,
            f.id AS file_id,
            f.p_table AS file_p_table,
            f.p_no AS file_p_no,
            f.file_name AS file_file_name,
            f.origin_name AS file_origin_name,
            f.file_path AS file_file_path,
            f.file_size AS file_file_size,
            f.seq AS file_seq,
            f.type AS file_type,
            f.created_at AS file_created_at,
            f.updated_at AS file_updated_at
        FROM boards b
        LEFT JOIN files f ON b.no = f.p_no 
            AND f.p_table = 'boards' 
            AND f.type = 'MAIN'
        LEFT JOIN comments c ON b.id = c.board_id
        GROUP BY b.no, b.id, b.title, b.writer, b.content, b.created_at, b.updated_at, b.user_no, f.no, f.id, f.p_table, f.p_no, f.file_name, f.origin_name, f.file_path, f.file_size, f.seq, f.type, f.created_at, f.updated_at
        ORDER BY b.created_at DESC
    </select>

    <!-- 단건 조회 (PK로) -->
    <select id="select" resultType="com.dohwan.board.domain.Boards">
        SELECT *
        FROM boards
        WHERE no = #{no}
    </select>

    <!-- 단건 조회 (id로) -->
    <select id="selectById" resultType="com.dohwan.board.domain.Boards">
        SELECT *
        FROM boards
        WHERE id = #{id}
    </select>

    <!-- 등록 -->
    <insert id="insert" parameterType="com.dohwan.board.domain.Boards" useGeneratedKeys="true" keyProperty="no">
        INSERT INTO boards (id, title, writer, content, user_no)
        VALUES (#{id}, #{title}, #{writer}, #{content}, #{userNo})
    </insert>

    <!-- 전체 수정 (PK로) -->
    <update id="update" parameterType="com.dohwan.board.domain.Boards">
        UPDATE boards
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="writer != null">writer = #{writer},</if>
            <if test="content != null">content = #{content},</if>
            updated_at = NOW()
        </set>
        WHERE no = #{no}
    </update>

    <!-- 전체 수정 (id로) -->
    <update id="updateById" parameterType="com.dohwan.board.domain.Boards">
        UPDATE boards
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="writer != null">writer = #{writer},</if>
            <if test="content != null">content = #{content},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <!-- 삭제 (PK로) -->
    <delete id="delete" parameterType="long">
        DELETE FROM boards
        WHERE no = #{no}
    </delete>

    <!-- 삭제 (id로) -->
    <delete id="deleteById" parameterType="string">
        DELETE FROM boards
        WHERE id = #{id}
    </delete>

</mapper>
